        "body": {
          "mode": "raw",
          "raw": "{\n  \"message\": \"We investigated the webhook payload and detected a secret key mismatch. Updated docs sent.\",\n  \"author\": \"Neha Gupta\",\n  \"role\": \"Support Agent\",\n  \"statusUpdate\": \"Resolved\"\n}"
