  "item": [
    {
      "name": "Health Check",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/health",
          "host": ["{{baseUrl}}"],
          "path": ["health"]
        },
        "description": "Check if API server and database connection are active."
      }
    },
    {
      "name": "Get Dashboard Statistics",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/tickets/stats",
          "host": ["{{baseUrl}}"],
          "path": ["tickets", "stats"]
        },
        "description": "Fetch status counts (Open, In Progress, Resolved, Closed, Urgent) and category breakdown."
      }
    },
    {
      "name": "Get All Tickets",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/tickets?page=1&limit=10&sortBy=createdAt&order=desc",
          "host": ["{{baseUrl}}"],
          "path": ["tickets"],
          "query": [
            { "key": "page", "value": "1" },
            { "key": "limit", "value": "10" },
            { "key": "sortBy", "value": "createdAt" },
            { "key": "order", "value": "desc" }
          ]
        },
        "description": "Retrieve all tickets with optional pagination and sorting."
      }
    },
    {
      "name": "Filter & Search Tickets",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/tickets?status=Open&priority=Urgent&search=payment",
          "host": ["{{baseUrl}}"],
          "path": ["tickets"],
          "query": [
            { "key": "status", "value": "Open" },
            { "key": "priority", "value": "Urgent" },
            { "key": "search", "value": "payment" }
          ]
        },
        "description": "Filter tickets by status, priority, category or search query."
      }
    },
    {
      "name": "Get Ticket by ID",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/tickets/{{ticketId}}",
          "host": ["{{baseUrl}}"],
          "path": ["tickets", "{{ticketId}}"]
        },
        "description": "Fetch full ticket information and conversation thread."
      }
    },
    {
      "name": "Create New Ticket",
      "request": {
        "method": "POST",
        "header": [
          { "key": "Content-Type", "value": "application/json" }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"title\": \"Unable to login\",\n  \"description\": \"Login issue\",\n  \"priority\": \"HIGH\",\n  \"status\": \"OPEN\",\n  \"category\": \"TECHNICAL\"\n}"
        },
        "url": {
          "raw": "{{baseUrl}}/tickets",
          "host": ["{{baseUrl}}"],
          "path": ["tickets"]
        },
        "description": "Create a new support ticket."
      }
    },
    {
      "name": "Update Ticket",
      "request": {
        "method": "PUT",
        "header": [
          { "key": "Content-Type", "value": "application/json" }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"status\": \"In Progress\",\n  \"priority\": \"Urgent\",\n  \"assignedTo\": \"Neha Gupta\"\n}"
        },
        "url": {
          "raw": "{{baseUrl}}/tickets/{{ticketId}}",
          "host": ["{{baseUrl}}"],
          "path": ["tickets", "{{ticketId}}"]
        },
        "description": "Update ticket status, priority, or assignment."
      }
    },
    {
      "name": "Add Response / Comment to Ticket",
      "request": {
        "method": "POST",
        "header": [
